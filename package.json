{
  "name": "tavli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/bundle-server.mjs",
    "start": "node dist-server/index.mjs --static",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "format": "prettier --write src server tests scripts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src server tests scripts index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "0.180.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
