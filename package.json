{
  "name": "tavli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/bundle-server.mjs",
    "start": "node dist-server/index.mjs --static",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings=0 .",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm run test:browser:local",
    "verify:full": "npm run check && npm run test:browser",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:property": "node --import=tsx --test tests/session-properties.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:local": "node scripts/browser-smoke.mjs --local",
    "test:browser:headed": "node scripts/browser-smoke.mjs --headed",
    "ios:sync": "npm run build && cap sync ios",
    "format": "prettier --write src server tests scripts index.html vite.config.ts stryker.config.mjs tsconfig.json .oxlintrc.json package.json",
    "format:check": "prettier --check src server tests scripts index.html vite.config.ts stryker.config.mjs tsconfig.json .oxlintrc.json package.json"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "cannon-es": "0.20.0",
    "mongodb": "^7.9.1",
    "three": "0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@stryker-mutator/core": "^10.1.1",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "fast-check": "^4.11.0",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.94.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "tsrs": "^7.1.0-beta.tsrs4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "^11.0.9",
      "typed-rest-client": {
        "qs": "^6.17.1"
      }
    }
  }
}
