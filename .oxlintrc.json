{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript", "oxc"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "dist-server/**", "node_modules/**", "assets/source/generated/**"],
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "rules": {
    "prefer-const": "off",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
